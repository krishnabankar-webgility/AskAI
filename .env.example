# =============================================================================
# AskAI Workspace — .env.example
# Copy this file to .env and fill in real values.
# .env is git-ignored. Never commit real credentials.
# =============================================================================

# --- Elasticsearch / Kibana WD ---
# KIBANA_WD_AUTH is used by the agent for log queries via Kibana proxy
# Format: username:password (LDAP credentials)
KIBANA_WD_AUTH=replace-with-ldap-username:password

# --- Slack ---
# Webhook URL for posting daily reports to #wd_performance
SLACK_WEBHOOK_MY_DAILY_UPDATE=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Channel name for Slack posts (default: wd_performance)
SLACK_CHANNEL=wd_performance
