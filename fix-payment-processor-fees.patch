diff --git a/Desktop/wg.eCC.OnlineStoreFactory/CloudIntegrationService/PaymentProcessorFeeHelper.cs b/Desktop/wg.eCC.OnlineStoreFactory/CloudIntegrationService/PaymentProcessorFeeHelper.cs
new file mode 100644
index 0000000..a323f43
--- /dev/null
+++ b/Desktop/wg.eCC.OnlineStoreFactory/CloudIntegrationService/PaymentProcessorFeeHelper.cs
@@ -0,0 +1,116 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using wg.eCC.DTO;
+using wg.eCC.DTO.StoreService;
+using wg.Unify.DTO;
+using wg.Unify.DTO.Shared;
+using wg.Unify.OnlineStoreFactory.CloudIntegrationService.DTO;
+using WgUtility;
+using WgUtility.Logging;
+
+namespace wg.eCC.OnlineStoreFactory.CloudIntegrationService
+{
+    /// <summary>
+    /// UD-32242: Shared helper for adjusting per-payment-line processor fees when fees
+    /// are recorded as line items. Originally implemented in ShopifyCloudIntegrationService_Parsing,
+    /// extracted here so Square, Clover, Etsy, Uniform, and any future CIS parsers
+    /// can reuse the same logic.
+    /// </summary>
+    internal static class PaymentProcessorFeeHelper
+    {
+        /// <summary>
+        /// When ADJUST_PAYPROFEES_IF_RECORDASLINE_&lt;ProfileID&gt; is active and fees are recorded as line items,
+        /// subtract processor fees per payment line (per capture): match each PaymentDetailDTO to OrderPaymentTransaction
+        /// by PaymentTransactionID / TransactionNumber, or to OrderPayment by PaymentTransactionId when balance rows are absent.
+        /// </summary>
+        internal static void AdjustPaymentAmountByProcessorFee(ProfileAdminDTO objprofileAdminDTO, ServiceOrderDTO objServiceOrderDTO, MarshalledData objMarshalledData)
+        {
+            try
+            {
+                if (!(CommonUtility.CustomizationNode.Contains(CustomizationConstant.ADJUST_PAYPROFEES_IF_RECORDASLINE + UtilityFunctions.ToStr(objprofileAdminDTO.ProfileID))
+                    && objprofileAdminDTO.ISPaymentProcessorApplicable
+                    && objprofileAdminDTO.StorePaymentProcessor != null
+                    && UtilityFunctions.ToEqual(objprofileAdminDTO.StorePaymentProcessor.AccountingTransactionType, "Line Item")))
+                    return;
+
+                if (objServiceOrderDTO.PaymentProcessorFees <= 0 || objServiceOrderDTO.PaymentDetails == null || !objServiceOrderDTO.PaymentDetails.Any())
+                    return;
+
+                bool anyAdjusted = false;
+                foreach (PaymentDetailDTO detail in objServiceOrderDTO.PaymentDetails)
+                {
+                    double feeForLine = GetProcessorFeeForPaymentLine(objprofileAdminDTO, detail, objMarshalledData);
+                    if (feeForLine <= 0)
+                        continue;
+
+                    if (detail.Amount < feeForLine)
+                    {
+                        LogManager.GetLogger().Warning(string.Format("ADJUST_PAYPROFEES_IF_RECORDASLINE skipped for a line — payment amount ({0}) is less than line processor fee ({1}). ProfileID={2}, OrderId={3}, PaymentTxnId={4}.",
+                            detail.Amount, feeForLine, objprofileAdminDTO.ProfileID, objServiceOrderDTO.OrderId, detail.PaymentTransactionID));
+                        continue;
+                    }
+
+                    double dblOriginalAmount = detail.Amount;
+                    detail.Amount = UtilityFunctions.ToRoundOff(dblOriginalAmount - feeForLine);
+                    anyAdjusted = true;
+                    LogManager.GetLogger().Info(string.Format("ADJUST_PAYPROFEES_IF_RECORDASLINE applied (per line). ProfileID={0}, OrderId={1}, OriginalAmount={2}, LineFee={3}, AdjustedAmount={4}, PaymentTxnId={5}.",
+                        objprofileAdminDTO.ProfileID, objServiceOrderDTO.OrderId, dblOriginalAmount, feeForLine, detail.Amount, detail.PaymentTransactionID));
+                }
+
+                if (!anyAdjusted)
+                    LogManager.GetLogger().Warning(string.Format("ADJUST_PAYPROFEES_IF_RECORDASLINE — no payment lines adjusted (no matching OrderPaymentTransaction/OrderPayment fees for details). ProfileID={0}, OrderId={1}, OrderPaymentProcessorFees={2}.",
+                        objprofileAdminDTO.ProfileID, objServiceOrderDTO.OrderId, objServiceOrderDTO.PaymentProcessorFees));
+            }
+            catch (Exception ex)
+            {
+                LogManager.GetLogger().Exception(ex, true);
+            }
+        }
+
+        /// <summary>
+        /// Fee attributed to one payment line: sum of OrderPaymentTransaction.Fees for matching TransactionNumber,
+        /// else fees from matching OrderPayment (same rules as aggregate parse).
+        /// </summary>
+        private static double GetProcessorFeeForPaymentLine(ProfileAdminDTO objprofileAdminDTO, PaymentDetailDTO detail, MarshalledData objMarshalledData)
+        {
+            if (UtilityFunctions.IsNullOrBlank(detail.PaymentTransactionID) || objMarshalledData == null)
+                return 0;
+
+            if (objMarshalledData.OrderPaymentTransaction != null && objMarshalledData.OrderPaymentTransaction.Count > 0)
+            {
+                double sumTxn = objMarshalledData.OrderPaymentTransaction
+                    .Where(t => UtilityFunctions.ToEqual(t.TransactionNumber, detail.PaymentTransactionID))
+                    .Sum(t => t.Fees > 0 ? t.Fees : 0);
+                if (sumTxn > 0)
+                    return sumTxn;
+            }
+
+            if (objMarshalledData.OrderPayment == null || objMarshalledData.OrderPayment.Count == 0)
+                return 0;
+
+            foreach (OrderPayment op in objMarshalledData.OrderPayment)
+            {
+                if (!UtilityFunctions.ToEqual(op.PaymentTransactionId, detail.PaymentTransactionID))
+                    continue;
+                if (!(UtilityFunctions.ToEqual(op.Kind, "SALE") || UtilityFunctions.ToEqual(op.Kind, "CAPTURE")))
+                    continue;
+                if (!UtilityFunctions.ToEqual(op.Status, "SUCCESS"))
+                    continue;
+
+                double fee = 0;
+                if (op.Fees != 0)
+                    fee = UtilityFunctions.getDouble(CommonUtility.SplitDecimalInAmount(op.Fees));
+                else if (op.TransactionFeeTotalAmount != 0 && !UtilityFunctions.ToEqual(op.Kind, "refund"))
+                    fee = UtilityFunctions.getDouble(CommonUtility.SplitDecimalInAmount(op.TransactionFeeTotalAmount));
+                else if (op.PaymentFees != 0)
+                    fee = op.PaymentFees;
+
+                if (fee > 0)
+                    return fee;
+            }
+
+            return 0;
+        }
+    }
+}
